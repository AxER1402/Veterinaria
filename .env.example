# Copiar a .env y rellenar. El .env NUNCA se sube al repositorio (A05 / PCI-DSS).
# Generar secretos con:  openssl rand -base64 48 | tr -d '/+=' | cut -c1-48

# ---------- Gateway ----------
SERVER_NAME=localhost
HTTP_PORT=8088
HTTPS_PORT=8443
# Red del proxy que está delante del gateway (se confía en su X-Forwarded-For). Ej.: 172.17.0.1/32 o los rangos de Cloudflare.
TRUSTED_PROXY=127.0.0.1/32

# ---------- JWT ----------
JWT_SECRET=
SERVICE_JWT_SECRET=
# Llave para cifrar los secretos TOTP (MFA) en auth_db. Si cambia, los usuarios con MFA deben reconfigurarlo.
MFA_ENCRYPTION_KEY=

# ---------- Redis ----------
REDIS_PASSWORD=

# ---------- MariaDB maestro / réplica ----------
DB_ROOT_PASSWORD=
DB_REPLICATION_PASSWORD=
AUTH_DB_PASSWORD=
CATALOGO_DB_PASSWORD=
PEDIDOS_DB_PASSWORD=
PAGOS_DB_PASSWORD=
CITAS_DB_PASSWORD=

# ---------- MariaDB auditoría ----------
AUDIT_DB_ROOT_PASSWORD=
AUDIT_DB_PASSWORD=

# ---------- Cloudinary (CDN de imágenes; opcional en local) ----------
# Sin estos valores las imágenes se sirven desde su origen y la subida firmada responde 503.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- Pagos (sandbox) ----------
# Stripe: https://dashboard.stripe.com/test/apikeys · el webhook secret lo da `stripe listen` o el panel de webhooks.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# PayPal: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ---------- Pedidos ----------
# Horas que un pedido puede quedar pendiente de pago antes de cancelarse y liberar el stock
PEDIDO_VENCE_HORAS=24

# ---------- Notificaciones ----------
# EmailJS: https://dashboard.emailjs.com (activar "Allow EmailJS API for non-browser applications")
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
# Firma HMAC del código de verificación de cada comprobante
COMPROBANTE_SECRET=

# ---------- Clima del panel admin (opcional) ----------
# OpenWeatherMap (https://home.openweathermap.org/api_keys). Sin clave se usa Open-Meteo, que no la pide.
OPENWEATHER_API_KEY=

# ---------- Google Maps Embed (opcional; restringir la key al dominio) ----------
GOOGLE_MAPS_EMBED_KEY=

# ---------- Respaldos (ops/backup.sh) ----------
# Clave del cifrado AES-256 de los respaldos. Guardarla FUERA del servidor (gestor de contraseñas):
# sin ella los respaldos no se pueden restaurar.
BACKUP_PASSPHRASE=
BACKUP_RETENCION_DIAS=30
# Opcional: copia remota en S3 o Cloudflare R2 (endpoint https://<cuenta>.r2.cloudflarestorage.com)
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
