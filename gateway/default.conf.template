# API Gateway Huellitas. Plantilla: Nginx sustituye ${SERVER_NAME} y ${HTTPS_PORT} al arrancar.

server_tokens off;

# IP real del cliente cuando hay un proxy delante (Nginx del VPS). Solo se cree la cabecera si la
# conexión viene de TRUSTED_PROXY. Se usa X-Real-IP, que el proxy SOBRESCRIBE con $remote_addr, y no
# X-Forwarded-For con recursión: con esta última, un valor inventado por el cliente a la izquierda de
# la cadena se acepta si la conexión entra desde una IP de la subred de confianza (comprobado).
set_real_ip_from ${TRUSTED_PROXY};
real_ip_header X-Real-IP;
real_ip_recursive off;
client_max_body_size 1m;
client_body_timeout 10s;
client_header_timeout 10s;

# ---------- Rate limiting (A07, D de STRIDE) ----------
limit_req_zone $binary_remote_addr zone=general:10m rate=30r/s;
limit_req_zone $binary_remote_addr zone=login:10m   rate=20r/m;
# Una zona por servicio: la ráfaga en uno no deja sin cupo a los demás.
limit_req_zone $binary_remote_addr zone=auth:10m      rate=10r/s;
limit_req_zone $binary_remote_addr zone=catalogo:10m  rate=20r/s;
limit_req_zone $binary_remote_addr zone=pedidos:10m   rate=10r/s;
limit_req_zone $binary_remote_addr zone=cotizar:10m   rate=5r/s;
limit_req_zone $binary_remote_addr zone=auditoria:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=citas:10m     rate=10r/s;
limit_conn_zone $binary_remote_addr zone=conexiones:10m;
limit_req_status 429;
limit_conn_status 429;

# ---------- WAF básico: firmas conocidas de SQLi / XSS / path traversal ----------
# Nginx no inspecciona el cuerpo; esa segunda capa está en Huellitas\Validar::sinAtaques().
map $request_uri $waf_uri {
    default 0;
    "~*(union(\s|\+|%20|/\*.*\*/)+(all(\s|\+|%20)+)?select)"           1;
    "~*(<|%3c)(\s|%20)*/?(\s|%20)*(script|iframe|svg|img)"             1;
    "~*(javascript|vbscript)(:|%3a)"                                   1;
    "~*(\.\./|\.\.%2f|%2e%2e/|%2e%2e%2f)"                             1;
    "~*(information_schema|sleep(\s|%20)*\(|benchmark(\s|%20)*\(|load_file)" 1;
    "~*(/etc/passwd|/proc/self|\.env|\.git/)"                          1;
    "~*('|%27)(\s|\+|%20)*(or|and)(\s|\+|%20)+[^&]*="                1;
}
map $http_user_agent $waf_ua {
    default 0;
    "~*(sqlmap|nikto|masscan|acunetix|havij|dirbuster|nessus|w3af)"     1;
}
map "$http_referer$http_cookie" $waf_cabeceras {
    default 0;
    "~*(<script|union(\s|\+)+select|javascript:)"                      1;
}

# Se vuelve a resolver cada 10 s con el DNS de Docker: si un servicio se recrea y cambia de IP,
# el gateway lo sigue encontrando sin reiniciarse.
resolver 127.0.0.11 valid=10s ipv6=off;

upstream auth_service { zone up_auth 64k; server auth-service:8081 resolve; keepalive 16; }
upstream catalogo_service { zone up_catalogo 64k; server catalogo-service:8082 resolve; keepalive 16; }
upstream pedidos_service { zone up_pedidos 64k; server pedidos-service:8083 resolve; keepalive 16; }
upstream pagos_service { zone up_pagos 64k; server pagos-service:8084 resolve; keepalive 8; }
upstream citas_service { zone up_citas 64k; server citas-service:8087 resolve; keepalive 8; }
upstream audit_service { zone up_audit 64k; server security-audit-service:8086 resolve; keepalive 8; }

# ---------- HTTP → HTTPS ----------
server {
    listen 80;
    server_name _;

    # Salud para el healthcheck del contenedor (sin redirección).
    location = /salud { access_log off; default_type text/plain; return 200 "ok\n"; }
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host:${HTTPS_PORT}$request_uri; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${SERVER_NAME};

    # A02 / PCI-DSS: solo TLS 1.3.
    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols       TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_tickets off;

    # ---------- Cabeceras de seguridad (A05) ----------
    include /etc/nginx/conf.d/cabeceras_seguridad.inc;

    limit_conn conexiones 50;

    if ($waf_uri)       { return 403; }
    if ($waf_ua)        { return 403; }
    if ($waf_cabeceras) { return 403; }

    # Solo métodos esperados.
    if ($request_method !~ ^(GET|HEAD|POST|PUT|PATCH|DELETE|OPTIONS)$) { return 405; }

    # Las rutas /internal/* son solo para comunicación entre servicios: nunca se publican.
    location ^~ /internal/ { return 404; }

    location = /api/auth/login {
        limit_req zone=login burst=10 nodelay;
        proxy_pass http://auth_service;
        include /etc/nginx/conf.d/proxy_comun.inc;
    }
    # Segundo paso del login (código MFA): mismo límite estricto que /login.
    location = /api/auth/login/mfa {
        limit_req zone=login burst=10 nodelay;
        proxy_pass http://auth_service;
        include /etc/nginx/conf.d/proxy_comun.inc;
    }
    location /api/auth/ {
        limit_req zone=auth burst=20 nodelay;
        proxy_pass http://auth_service;
        include /etc/nginx/conf.d/proxy_comun.inc;
    }
    location /api/catalogo/ {
        limit_req zone=catalogo burst=40 nodelay;
        proxy_pass http://catalogo_service;
        include /etc/nginx/conf.d/proxy_comun.inc;
    }
    location = /api/pedidos/cotizar {
        limit_req zone=cotizar burst=15 nodelay;
        proxy_pass http://pedidos_service;
        include /etc/nginx/conf.d/proxy_comun.inc;
    }
    location /api/pedidos {
        limit_req zone=pedidos burst=30 nodelay;
        proxy_pass http://pedidos_service;
        include /etc/nginx/conf.d/proxy_comun.inc;
    }
    # De /api/pagos/ solo se publica el webhook de Stripe (autenticado por firma). El resto de
    # pagos es interno: el navegador paga a través de /api/pedidos/{id}/pago.
    location = /api/pagos/webhook/stripe {
        limit_req zone=pedidos burst=30 nodelay;
        proxy_pass http://pagos_service;
        include /etc/nginx/conf.d/proxy_comun.inc;
    }
    location /api/citas {
        limit_req zone=citas burst=40 nodelay;
        proxy_pass http://citas_service;
        include /etc/nginx/conf.d/proxy_comun.inc;
    }
    location /api/auditoria/ {
        limit_req zone=auditoria burst=30 nodelay;
        proxy_pass http://audit_service;
        include /etc/nginx/conf.d/proxy_comun.inc;
    }
    location /api/ { default_type application/json; return 404 '{"error":"Recurso no encontrado"}'; }

    # ---------- Frontend (SPA) ----------
    root /usr/share/nginx/html;
    index index.html;
    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    location /assets/ {
        limit_req zone=general burst=100 nodelay;
        expires 1y;
        add_header Cache-Control "public, immutable";
        # add_header en un location anula los del server: se vuelven a incluir.
        include /etc/nginx/conf.d/cabeceras_seguridad.inc;
        try_files $uri =404;
    }
    location / {
        limit_req zone=general burst=50 nodelay;
        try_files $uri $uri/ /index.html;
    }
}
